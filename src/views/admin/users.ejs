<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/public/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body {
            background: #212529;
            color: #f8f9fa;
        }
        .navbar-custom {
            background: #343a40;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: #f8f9fa !important;
        }
        .card {
            background: #2c3034;
            border: 1px solid #495057;
        }
        .card-header {
            background: #2c3034;
            border-bottom: 1px solid #495057;
            color: #f8f9fa;
        }
        .card-header h5,
        .card-header h6 {
            color: #f8f9fa;
        }
        .form-control {
            background: #2c3034;
            border: 1px solid #495057;
            color: #f8f9fa;
        }
        .form-control:focus {
            background: #2c3034;
            border-color: #86b7fe;
            color: #f8f9fa;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .form-label {
            color: #e9ecef;
        }
        .table {
            color: #f8f9fa;
            border-color: #495057;
        }
        .table > :not(caption) > * > * {
            background-color: transparent;
            color: #f8f9fa;
            border-color: #495057;
        }
        .table-hover tbody tr:hover {
            background: #3a3f44;
        }
        .modal-content {
            background: #2c3034;
            border: 1px solid #495057;
            color: #f8f9fa;
        }
        .modal-header {
            border-bottom: 1px solid #495057;
        }
        .modal-footer {
            border-top: 1px solid #495057;
        }
        .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
        .text-muted {
            color: #adb5bd !important;
        }
        .btn-primary {
            background: #0d6efd;
            border: none;
        }
        .btn-primary:hover {
            background: #0b5ed7;
        }
        .btn-outline-light {
            border-color: #f8f9fa;
            color: #f8f9fa;
        }
        .btn-outline-light:hover {
            background: #f8f9fa;
            color: #212529;
        }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'users', navbarFixed: false }) %>

    <div class="container mt-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Users</h5>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal" onclick="prepareAddUser()">Add New User</button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="loginIdFilter" placeholder="Filter by LoginID..." autocomplete="off" onkeyup="filterUsers()">
                </div>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>LoginID</th>
                                <th>TeamID</th>
                                <th>AccessCode</th>
                                <th>Permissions</th>
                                <th>Is Admin</th>
                                <th>Enabled</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersBody">
                            <tr><td colspan="7" class="text-center">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="userModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="userForm">
                    <div class="modal-body">
                        <input type="hidden" id="editLoginId" name="editLoginId">
                        <div class="mb-3">
                            <label for="loginId" class="form-label">LoginID</label>
                            <input type="text" class="form-control text-bg-secondary" id="loginId" name="loginId" required>
                        </div>
                        <div class="mb-3">
                            <label for="sid" class="form-label">TeamID</label>
                            <input type="text" class="form-control" id="sid" name="sid" required>
                        </div>
                        <div class="mb-3">
                            <label for="accessCode" class="form-label">AccessCode</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="accessCode" name="accessCode" placeholder="Leave empty to auto-generate">
                                <button class="btn btn-outline-light" type="button" id="regenerateBtn" onclick="regenerateAccessCode()" style="display:none;">Regenerate</button>
                            </div>
                            <small class="text-muted" id="accessCodeHint">AccessCode will be generated automatically when user is created if left empty</small>
                        </div>
                        <div class="mb-3">
                            <label for="prm" class="form-label">Permissions (hex)</label>
                            <input type="text" class="form-control" id="prm" name="prm" value="0xffffffff" required>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="isadmin" name="isadmin">
                            <label class="form-check-label" for="isadmin">Is Admin</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Login QR Modal -->
    <div class="modal fade" id="qrModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Login QR — <span id="qrLoginNameLabel"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="qrInputSection">
                        <p class="text-muted">Enter this login's access code. It is verified against the server before the QR is generated.</p>
                        <input type="password" class="form-control" id="qrAccessCodeInput" placeholder="Enter access code">
                        <div id="qrError" class="alert alert-danger mt-3 mb-0" style="display:none"></div>
                    </div>
                    <div id="qrResultSection" style="display:none">
                        <div class="text-center">
                            <code id="qrPlainCode" class="d-block fs-5 fw-bold text-success mb-2"></code>
                            <div id="qrImage" class="d-inline-block p-2 rounded" style="background:#fff"></div>
                        </div>
                        <p class="text-warning small mt-3 mb-0">
                            This QR contains a login credential — treat it like a password.
                        </p>
                    </div>
                </div>
                <div class="modal-footer" id="qrFooterInput">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="qrVerifyBtn" onclick="submitQrVerify()">Verify &amp; Generate</button>
                </div>
                <div class="modal-footer" id="qrFooterDone" style="display:none">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/public/qrcode/qrcode.js"></script>
    <script>
        let users = {};
        let userModal;
        let qrModal;
        let qrLoginName = '';
        const AUTH_SERVER_PORT = <%- JSON.stringify(typeof authServerPort !== 'undefined' ? authServerPort : null) %>;

        // Permissions are stored as INTEGER; display as '0x........' hex.
        function fmtPerm(p) {
            if (typeof p === 'number' && Number.isFinite(p)) return '0x' + (p >>> 0).toString(16).padStart(8, '0');
            return p;
        }

        document.addEventListener('DOMContentLoaded', function() {
            userModal = new bootstrap.Modal(document.getElementById('userModal'));
            qrModal = new bootstrap.Modal(document.getElementById('qrModal'));
            // Browsers restore form values on soft reload — clear the filter so
            // a stale value can't silently hide users.
            document.getElementById('loginIdFilter').value = '';
            loadUsers();
        });

        async function loadUsers() {
            try {
                const response = await fetch('/admin/api/users');
                const data = await response.json();
                users = data.users || {};
                renderUsers();
            } catch (error) {
                console.error('Error loading users:', error);
                document.getElementById('usersBody').innerHTML = '<tr><td colspan="7" class="text-center text-danger">Error loading users</td></tr>';
            }
        }

        function renderUsers() {
            const tbody = document.getElementById('usersBody');
            const filterText = document.getElementById('loginIdFilter').value.toLowerCase();

            let filteredUsers = Object.entries(users);

            // Apply LoginID filter
            if (filterText) {
                filteredUsers = filteredUsers.filter(([loginID, user]) =>
                    loginID.toLowerCase().includes(filterText)
                );
            }

            if (filteredUsers.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center">No users found</td></tr>';
                return;
            }

            // Sort by SID (TeamID)
            filteredUsers.sort((a, b) => a[1].sid - b[1].sid);

            tbody.innerHTML = filteredUsers.map(([loginID, user]) => `
                <tr>
                    <td>${loginID}</td>
                    <td>${user.sid}</td>
                    <td>${user.hasAccessCode !== false ? '••••••••' : 'N/A'}</td>
                    <td>${fmtPerm(user.prm)}</td>
                    <td>${user.isadmin ? '<span class="badge bg-success" style="min-width:45px">Yes</span>' : '<span class="badge bg-secondary" style="min-width:45px">No</span>'}</td>
                    <td>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" ${user.enabled !== false ? 'checked' : ''} onchange="toggleUserEnabled('${loginID}', this.checked, this)" title="Enable/disable login">
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-success me-1" onclick="openQrModal('${loginID}')" title="Generate login QR"><i class="bi bi-qr-code"></i></button>
                        <button class="btn btn-sm btn-primary me-1" onclick="editUser('${loginID}')" title="Edit"><i class="bi bi-pencil-square"></i></button>
                        <button class="btn btn-sm btn-danger" onclick="deleteUser('${loginID}')" title="Delete"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function filterUsers() {
            renderUsers();
        }

        async function toggleUserEnabled(loginID, enabled, inputEl) {
            try {
                const response = await fetch(`/admin/api/users/${encodeURIComponent(loginID)}/enabled`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: enabled })
                });
                const data = await response.json();

                if (data.error === 0) {
                    users[loginID].enabled = enabled;
                } else {
                    inputEl.checked = !enabled;
                    alert('Error updating user: ' + (data.errorMessage || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error updating user:', error);
                inputEl.checked = !enabled;
                alert('Error updating user');
            }
        }

        function prepareAddUser() {
            const form = document.getElementById('userForm');
            const title = document.getElementById('modalTitle');
            form.reset();
            document.getElementById('editLoginId').value = '';
            document.getElementById('loginId').disabled = false;
            document.getElementById('accessCode').value = '';
            document.getElementById('accessCode').placeholder = 'Leave empty to auto-generate';
            document.getElementById('accessCodeHint').textContent = 'AccessCode will be generated automatically when user is created if left empty';
            document.getElementById('regenerateBtn').style.display = 'none';
            title.textContent = 'Add New User';
        }

        function editUser(loginID) {
            const form = document.getElementById('userForm');
            const title = document.getElementById('modalTitle');

            form.reset();
            document.getElementById('editLoginId').value = loginID;
            document.getElementById('loginId').value = loginID;
            document.getElementById('sid').value = users[loginID].sid;
            // Do NOT show the hashed AccessCode — leave empty so admin can enter a new one.
            document.getElementById('accessCode').value = '';
            document.getElementById('accessCode').placeholder = 'Enter new password to change, leave empty to keep current';
            document.getElementById('accessCodeHint').textContent = 'Leave empty to keep the current password unchanged';
            document.getElementById('regenerateBtn').style.display = 'inline-block';
            document.getElementById('prm').value = fmtPerm(users[loginID].prm);
            document.getElementById('isadmin').checked = users[loginID].isadmin;
            document.getElementById('loginId').disabled = true;
            title.textContent = 'Edit User';

            userModal.show();
        }

        function regenerateAccessCode() {
            // Generate a random 12-char access code (same algorithm as server-side)
            const chars = '0123456789abcdef';
            let code = '';
            for (let i = 0; i < 12; i++) {
                code += chars[Math.floor(Math.random() * chars.length)];
            }
            document.getElementById('accessCode').value = code;
        }

        // ── Login QR helpers ──────────────────────────────────────────────
        // The QR carries a versioned JSON payload scanned by the Android app.
        // Access codes are stored hashed, so a QR can only embed a code the
        // admin types (verified server-side) or one just created/rotated.

        function buildLoginQrPayload(loginName, accessCode) {
            const payload = { v: 1, t: 'de_login', acc: loginName, pwd: accessCode, ah: window.location.hostname };
            if (AUTH_SERVER_PORT) payload.ap = AUTH_SERVER_PORT;
            return JSON.stringify(payload);
        }

        function renderQrInto(el, text) {
            const qr = qrcode(0, 'M');
            qr.addData(text);
            qr.make();
            el.innerHTML = qr.createImgTag(6, 8);
        }

        function openQrModal(loginID) {
            qrLoginName = loginID;
            document.getElementById('qrLoginNameLabel').textContent = loginID;
            document.getElementById('qrAccessCodeInput').value = '';
            document.getElementById('qrError').style.display = 'none';
            document.getElementById('qrInputSection').style.display = '';
            document.getElementById('qrResultSection').style.display = 'none';
            document.getElementById('qrFooterInput').style.display = '';
            document.getElementById('qrFooterDone').style.display = 'none';
            qrModal.show();
            setTimeout(() => document.getElementById('qrAccessCodeInput').focus(), 300);
        }

        function showQrResult(loginID, code) {
            document.getElementById('qrPlainCode').textContent = code;
            renderQrInto(document.getElementById('qrImage'), buildLoginQrPayload(loginID, code));
            document.getElementById('qrInputSection').style.display = 'none';
            document.getElementById('qrResultSection').style.display = '';
            document.getElementById('qrFooterInput').style.display = 'none';
            document.getElementById('qrFooterDone').style.display = '';
            qrModal.show();
        }

        async function submitQrVerify() {
            const code = document.getElementById('qrAccessCodeInput').value.trim();
            const errEl = document.getElementById('qrError');
            errEl.style.display = 'none';
            if (!code) {
                errEl.textContent = 'Enter the access code.';
                errEl.style.display = '';
                return;
            }
            const btn = document.getElementById('qrVerifyBtn');
            btn.disabled = true;
            try {
                const response = await fetch('/admin/api/verify-login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ loginId: qrLoginName, accessCode: code })
                });
                const data = await response.json();
                if (data.error === 0) {
                    showQrResult(qrLoginName, code);
                } else {
                    errEl.textContent = data.errorMessage || 'Access code does not match.';
                    errEl.style.display = '';
                }
            } catch (e) {
                errEl.textContent = 'Verification failed.';
                errEl.style.display = '';
            }
            btn.disabled = false;
        }

        async function deleteUser(loginID) {
            if (!confirm(`Are you sure you want to delete user ${loginID}?`)) {
                return;
            }

            try {
                const response = await fetch(`/admin/api/users/${encodeURIComponent(loginID)}`, {
                    method: 'DELETE'
                });
                const data = await response.json();

                if (data.error === 0) {
                    delete users[loginID];
                    renderUsers();
                } else {
                    alert('Error deleting user: ' + (data.errorMessage || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error deleting user:', error);
                alert('Error deleting user');
            }
        }

        document.getElementById('userForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const formData = new FormData(e.target);
            const accessCode = formData.get('accessCode').trim() || null;
            const userData = {
                sid: formData.get('sid').trim(),
                prm: formData.get('prm'),
                isadmin: document.getElementById('isadmin').checked,
                accessCode: accessCode
            };

            const editLoginId = formData.get('editLoginId');
            const loginId = formData.get('loginId');
            const method = editLoginId ? 'PUT' : 'POST';
            const url = editLoginId ? `/admin/api/users/${encodeURIComponent(editLoginId)}` : '/admin/api/users';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ email: loginId, ...userData })
                });
                const data = await response.json();

                if (data.error === 0) {
                    if (editLoginId) {
                        // Editing existing user
                        if (accessCode) {
                            userModal.hide();
                            showQrResult(editLoginId, data.AccessCode);
                        } else {
                            alert('User updated successfully!');
                        }
                    } else {
                        // Creating new user
                        if (data.AccessCode) {
                            userModal.hide();
                            showQrResult(loginId, data.AccessCode);
                        } else {
                            alert('User created successfully!');
                        }
                    }
                    userModal.hide();
                    loadUsers();
                } else {
                    alert('Error saving user: ' + (data.errorMessage || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error saving user:', error);
                alert('Error saving user');
            }
        });
    </script>
</body>
</html>
