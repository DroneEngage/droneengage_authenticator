<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #212529;
            color: #f8f9fa;
        }
        .navbar-custom {
            background: #343a40;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: #f8f9fa !important;
        }
        .card {
            background: #2c3034;
            border: 1px solid #495057;
        }
        .card-header {
            background: #2c3034;
            border-bottom: 1px solid #495057;
            color: #f8f9fa;
        }
        .card-header h5,
        .card-header h6 {
            color: #f8f9fa;
        }
        .server-card {
            border-left: 4px solid #198754;
            cursor: pointer;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
            background: #2c3034;
        }
        .server-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.5);
        }
        .server-card.offline {
            border-left-color: #dc3545;
        }
        .server-card.selected {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
        .card-title {
            color: #e9ecef;
        }
        .card-text {
            color: #adb5bd;
        }
        .connected-users-table {
            font-size: 0.85rem;
            table-layout: fixed;
            width: 100%;
        }
        .connected-users-table td {
            overflow-wrap: break-word;
        }
        .table-light {
            background: #2c3034;
            color: #f8f9fa;
        }
        .table {
            color: #f8f9fa;
            border-color: #495057;
        }
        .table > :not(caption) > * > * {
            background-color: transparent;
            color: #f8f9fa;
            border-color: #495057;
        }
        .text-muted {
            color: #adb5bd !important;
        }
        .btn-primary {
            background: #0d6efd;
            border: none;
        }
        .btn-primary:hover {
            background: #0b5ed7;
        }
        .btn-outline-light {
            border-color: #f8f9fa;
            color: #f8f9fa;
        }
        .btn-outline-light:hover {
            background: #f8f9fa;
            color: #212529;
        }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'servers', navbarFixed: false }) %>

    <div class="container-fluid mt-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Communication Servers</h5>
                <button class="btn btn-primary" onclick="loadServers()">Refresh</button>
            </div>
            <div class="card-body">
                <div class="row" id="serverGrid">
                    <div class="col-12 text-center">Loading servers...</div>
                </div>
                <div class="row mt-4" id="userPanel">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0" id="userPanelTitle">Connected Users</h5>
                            </div>
                            <div class="card-body" id="userPanelBody">
                                <p class="text-muted text-center mb-0">Select a server to view connected users</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-4" id="udpProxiesPanel">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0" id="udpProxiesPanelTitle">UDP Proxies</h5>
                                <button class="btn btn-primary btn-sm" id="udpProxiesQueryBtn" style="display:none" onclick="queryUdpProxies()">Query Now</button>
                            </div>
                            <div class="card-body" id="udpProxiesPanelBody">
                                <p class="text-muted text-center mb-0">Select a server to view its UDP proxies</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        let m_servers = [];
        let m_selectedServerId = null;

        async function loadServers() {
            try {
                const response = await fetch('/admin/api/servers');
                const data = await response.json();
                m_servers = data.servers || [];
                renderServers(m_servers);

                if (m_selectedServerId) {
                    const selectedServer = m_servers.find(s => s.serverId === m_selectedServerId);
                    if (selectedServer) {
                        selectServer(m_selectedServerId);
                    } else {
                        m_selectedServerId = null;
                        renderUserPanel(null);
                        renderUdpProxiesPanel(null);
                    }
                }
            } catch (error) {
                console.error('Error loading servers:', error);
                document.getElementById('serverGrid').innerHTML = '<div class="col-12 text-center text-danger">Error loading servers</div>';
            }
        }

        function renderServers(servers) {
            const grid = document.getElementById('serverGrid');

            if (servers.length === 0) {
                grid.innerHTML = '<div class="col-12 text-center">No communication servers found</div>';
                return;
            }

            grid.innerHTML = servers.map(server => {
                const serverId = server.serverId || 'unknown';
                const storageStatus = server.storageStatus || null;
                let storageStatusHtml = '';
                
                if (storageStatus) {
                    const stateMap = {
                        'cd': { label: 'connected',    color: 'bg-success' },
                        'dc': { label: 'disconnected', color: 'bg-danger'  },
                        'cg': { label: 'connecting',   color: 'bg-warning' },
                        'uh': { label: 'unhealthy',    color: 'bg-warning' },
                        'er': { label: 'error',        color: 'bg-danger'  }
                    };
                    const stateInfo = stateMap[storageStatus.status] || { label: storageStatus.status, color: 'bg-warning' };
                    storageStatusHtml = `
                        <p class="card-text mb-1 text-white">
                            <strong>Storage:</strong> 
                            <span class="badge ${stateInfo.color}">${stateInfo.label}</span>
                            ${storageStatus.storage_host ? ` (${storageStatus.storage_host}:${storageStatus.storage_port})` : ''}
                        </p>
                    `;
                } else {
                    storageStatusHtml = `
                        <p class="card-text mb-1 text-muted"><strong>Storage:</strong> Not reported</p>
                    `;
                }

                const udpProxyCount = (server.udpProxies || []).length;
                const udpProxiesHtml = server.udpProxiesTimestamp
                    ? `
                        <p class="card-text mb-1 text-white">
                            <strong>UDP Proxies:</strong>
                            <span class="badge ${udpProxyCount > 0 ? 'bg-info' : 'bg-secondary'}">${udpProxyCount} open</span>
                        </p>
                    `
                    : `
                        <p class="card-text mb-1 text-muted"><strong>UDP Proxies:</strong> Not queried</p>
                    `;

                return `
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card server-card ${server.isOnline ? '' : 'offline'} ${serverId === m_selectedServerId ? 'selected' : ''}" data-server-id="${encodeURIComponent(serverId)}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="card-title mb-0 text-warning">${serverId}</h6>
                                <span class="badge ${server.isOnline ? 'bg-success' : 'bg-danger'}">
                                    ${server.isOnline ? 'Online' : 'Offline'}
                                </span>
                            </div>
                            <p class="card-text mb-1 text-primary"><strong>Public IP:</strong> ${server.public_host || 'N/A'}</p>
                            <p class="card-text mb-1 text-primary"><strong>Port:</strong> ${server.serverPort || 'N/A'}</p>
                            <p class="card-text mb-1 text-white"><strong>Version:</strong> ${server.version || 'N/A'}</p>
                            ${storageStatusHtml}
                            ${udpProxiesHtml}
                        </div>
                    </div>
                </div>
                `;
            }).join('');

            attachServerCardListeners();
        }

        function attachServerCardListeners() {
            document.querySelectorAll('.server-card').forEach(card => {
                card.addEventListener('click', function() {
                    const serverId = decodeURIComponent(this.dataset.serverId);
                    selectServer(serverId);
                });
            });
        }

        function selectServer(serverId) {
            m_selectedServerId = serverId;
            const server = m_servers.find(s => s.serverId === serverId);
            if (!server) return;

            document.querySelectorAll('.server-card').forEach(card => {
                const cardServerId = decodeURIComponent(card.dataset.serverId);
                card.classList.toggle('selected', cardServerId === serverId);
            });

            renderUserPanel(server);
            renderUdpProxiesPanel(server);
        }

        function renderUserPanel(server) {
            const title = document.getElementById('userPanelTitle');
            const body = document.getElementById('userPanelBody');

            if (!server) {
                title.textContent = 'Connected Users';
                body.innerHTML = '<p class="text-muted text-center mb-0">Select a server to view connected users</p>';
                return;
            }

            const users = server.accounts || [];
            title.textContent = `Connected Users (${users.length}) - ${server.serverId || 'Unknown'}`;

            if (users.length === 0) {
                body.innerHTML = '<p class="text-muted text-center mb-0">No connected users</p>';
                return;
            }

            function getActorTypeLabel(actorType) {
                switch (actorType) {
                    case 'g': return 'GCS';
                    case 'd': return 'Agent';
                    case 'a': return 'Admin';
                    default: return 'Unknown';
                }
            }

            const rows = users.map(account => `
                <tr>
                    <td>${account.loginId || 'Unknown'}</td>
                    <td>
                        ${account.accountId}
                        <br><small class="text-muted">${account.hashedAccountId}</small>
                    </td>
                    <td>${account.unitName || 'N/A'}</td>
                    <td>${getActorTypeLabel(account.actorType)}</td>
                </tr>
            `).join('');

            body.innerHTML = `
                <table class="table table-striped table-bordered connected-users-table">
                    <thead class="table-light">
                        <tr>
                            <th>LoginID</th>
                            <th>AccountID</th>
                            <th>Unit</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rows}
                    </tbody>
                </table>
            `;
        }

        function formatUdpTime(ms) {
            return ms ? new Date(ms).toLocaleTimeString() : 'N/A';
        }

        function renderUdpProxiesPanel(server) {
            const title = document.getElementById('udpProxiesPanelTitle');
            const body = document.getElementById('udpProxiesPanelBody');
            const queryBtn = document.getElementById('udpProxiesQueryBtn');

            if (!server) {
                title.textContent = 'UDP Proxies';
                body.innerHTML = '<p class="text-muted text-center mb-0">Select a server to view its UDP proxies</p>';
                queryBtn.style.display = 'none';
                return;
            }

            queryBtn.style.display = '';
            queryBtn.disabled = !server.isOnline;

            const proxies = server.udpProxies || [];
            const queriedAt = server.udpProxiesTimestamp ? ` — as of ${formatUdpTime(server.udpProxiesTimestamp)}` : '';
            title.textContent = `UDP Proxies (${proxies.length}) - ${server.serverId || 'Unknown'}${queriedAt}`;

            if (!server.udpProxiesTimestamp) {
                body.innerHTML = '<p class="text-muted text-center mb-0">Not queried yet — click "Query Now"</p>';
                return;
            }

            if (proxies.length === 0) {
                body.innerHTML = '<p class="text-muted text-center mb-0">No open UDP proxies</p>';
                return;
            }

            const rows = proxies.map(proxy => `
                <tr>
                    <td>${proxy.name || 'Unknown'}</td>
                    <td>${proxy.socket1 ? `${proxy.socket1.address}:${proxy.socket1.port}` : 'N/A'}</td>
                    <td>${proxy.socket2 ? `${proxy.socket2.address}:${proxy.socket2.port}` : 'N/A'}</td>
                    <td><span class="badge ${proxy.ready ? 'bg-success' : 'bg-warning'}">${proxy.ready ? 'ready' : 'not ready'}</span></td>
                    <td>${formatUdpTime(proxy.created)}</td>
                    <td>${formatUdpTime(proxy.last_access)}</td>
                </tr>
            `).join('');

            body.innerHTML = `
                <table class="table table-striped table-bordered connected-users-table">
                    <thead class="table-light">
                        <tr>
                            <th>Unit</th>
                            <th>Socket 1</th>
                            <th>Socket 2</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Access</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${rows}
                    </tbody>
                </table>
            `;
        }

        async function queryUdpProxies() {
            if (!m_selectedServerId) return;
            const server = m_servers.find(s => s.serverId === m_selectedServerId);
            if (!server || !server.commServerGUID) return;

            const btn = document.getElementById('udpProxiesQueryBtn');
            const originalLabel = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Querying...';

            try {
                const response = await fetch(`/admin/api/servers/${encodeURIComponent(server.commServerGUID)}/query-udp-proxies`, { method: 'POST' });
                const data = await response.json();

                if (data.error === 0) {
                    server.udpProxies = data.proxies || [];
                    server.udpProxiesTimestamp = Date.now();
                    renderServers(m_servers);
                    renderUdpProxiesPanel(server);
                } else {
                    alert(data.errorMessage || 'Failed to query UDP proxies');
                }
            } catch (error) {
                console.error('Error querying UDP proxies:', error);
                alert('Error querying UDP proxies');
            } finally {
                btn.disabled = !server.isOnline;
                btn.textContent = originalLabel;
            }
        }

        loadServers();
        setInterval(loadServers, 30000);
    </script>
</body>
</html>
