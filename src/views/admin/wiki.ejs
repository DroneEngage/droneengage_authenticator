<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #212529;
            color: #f8f9fa;
        }
        .navbar-custom {
            background: #343a40;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: #f8f9fa !important;
        }
        .wiki-container {
            display: flex;
            min-height: calc(100vh - 56px);
        }
        .wiki-sidebar {
            width: 260px;
            min-width: 260px;
            background: #2c3034;
            border-right: 1px solid #495057;
            padding: 20px 0;
            overflow-y: auto;
        }
        .wiki-sidebar .sidebar-header {
            padding: 0 20px 12px;
            font-size: 14px;
            font-weight: bold;
            color: #adb5bd;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #495057;
            margin-bottom: 8px;
        }
        .wiki-sidebar a {
            display: block;
            padding: 8px 20px;
            color: #e9ecef;
            text-decoration: none;
            font-size: 14px;
            transition: background 0.15s;
        }
        .wiki-sidebar a:hover {
            background: #3a3f44;
            color: #fff;
        }
        .wiki-sidebar a.active {
            background: #0d6efd;
            color: #fff;
            font-weight: 500;
        }
        .wiki-content {
            flex: 1;
            padding: 24px 32px;
            overflow-y: auto;
            max-width: 100%;
        }
        .wiki-content .wiki-empty {
            text-align: center;
            padding: 60px 20px;
            color: #adb5bd;
        }
        .wiki-content .wiki-empty h2 {
            color: #e9ecef;
            margin-bottom: 16px;
        }
        /* Markdown content styling */
        .wiki-content h1 {
            color: #fff;
            border-bottom: 1px solid #495057;
            padding-bottom: 8px;
            margin-bottom: 20px;
            font-size: 1.8rem;
        }
        .wiki-content h2 {
            color: #e9ecef;
            margin-top: 32px;
            margin-bottom: 12px;
            font-size: 1.4rem;
        }
        .wiki-content h3 {
            color: #e9ecef;
            margin-top: 24px;
            margin-bottom: 10px;
            font-size: 1.2rem;
        }
        .wiki-content h4 {
            color: #adb5bd;
            margin-top: 20px;
            margin-bottom: 8px;
            font-size: 1.05rem;
        }
        .wiki-content p {
            color: #d1d5db;
            line-height: 1.7;
            margin-bottom: 14px;
        }
        .wiki-content a {
            color: #4dabf7;
            text-decoration: none;
        }
        .wiki-content a:hover {
            color: #74c0fc;
            text-decoration: underline;
        }
        .wiki-content code {
            background: #1a1a1a;
            color: #f0883e;
            padding: 2px 6px;
            border-radius: 4px;
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 0.9em;
        }
        .wiki-content pre {
            background: #1a1a1a;
            border: 1px solid #495057;
            border-radius: 6px;
            padding: 16px;
            overflow-x: auto;
            margin-bottom: 16px;
        }
        .wiki-content pre code {
            background: none;
            color: #e0e0e0;
            padding: 0;
            font-size: 0.9em;
        }
        .wiki-content table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
        }
        .wiki-content th {
            background: #343a40;
            color: #fff;
            padding: 10px 14px;
            text-align: left;
            border: 1px solid #495057;
            font-weight: 600;
        }
        .wiki-content td {
            padding: 8px 14px;
            border: 1px solid #495057;
            color: #d1d5db;
        }
        .wiki-content tr:nth-child(even) td {
            background: #2c3034;
        }
        .wiki-content blockquote {
            border-left: 4px solid #0d6efd;
            background: #2c3034;
            padding: 12px 20px;
            margin: 0 0 16px 0;
            color: #adb5bd;
        }
        .wiki-content blockquote p {
            margin-bottom: 0;
        }
        .wiki-content ul,
        .wiki-content ol {
            color: #d1d5db;
            padding-left: 24px;
            margin-bottom: 14px;
        }
        .wiki-content li {
            line-height: 1.7;
            margin-bottom: 4px;
        }
        .wiki-content img {
            max-width: 100%;
            height: auto;
            border-radius: 6px;
            border: 1px solid #495057;
            margin: 12px 0;
        }
        .wiki-content hr {
            border: none;
            border-top: 1px solid #495057;
            margin: 24px 0;
        }
        .btn-outline-light {
            border-color: #f8f9fa;
            color: #f8f9fa;
        }
        .btn-outline-light:hover {
            background: #f8f9fa;
            color: #212529;
        }
        .text-muted {
            color: #adb5bd !important;
        }
        /* Mobile: sidebar collapses */
        @media (max-width: 768px) {
            .wiki-sidebar {
                display: none;
            }
        }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'wiki', navbarFixed: false }) %>

    <div class="wiki-container">
        <div class="wiki-sidebar">
            <div class="sidebar-header">Wiki Pages</div>
            <% wikiPages.forEach(function(page) { %>
                <a href="/admin<%= serversStatusGuid ? '/' + serversStatusGuid : '' %>/wiki/<%= page.name %>"
                   class="<%= activeWikiPage === page.name ? 'active' : '' %>">
                    <%= page.title %>
                </a>
            <% }) %>
        </div>

        <div class="wiki-content">
            <% if (wikiContent) { %>
                <%- wikiContent %>
            <% } else { %>
                <div class="wiki-empty">
                    <h2>Wiki / Help</h2>
                    <p>Select a page from the sidebar to browse the documentation.</p>
                    <% if (wikiPages.length > 0) { %>
                        <div class="text-start" style="max-width: 500px; margin: 0 auto;">
                            <% wikiPages.forEach(function(page) { %>
                                <p>
                                    <a href="/admin<%= serversStatusGuid ? '/' + serversStatusGuid : '' %>/wiki/<%= page.name %>">
                                        <%= page.title %>
                                    </a>
                                </p>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No wiki pages found.</p>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
