<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/public/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #1a1d21;
            color: #f8f9fa;
        }
        .navbar-custom {
            background: #2a2e33;
            border-bottom: 2px solid #0d6efd;
        }
        .navbar-custom .navbar-brand,
        .navbar-custom .nav-link {
            color: #f8f9fa !important;
        }
        .card {
            background: #262b30;
            border: 1px solid #3a4148;
        }
        .card-header {
            background: #2c3338;
            border-bottom: 1px solid #3a4148;
            color: #f8f9fa;
        }
        .card-header h5,
        .card-header h6 {
            color: #f8f9fa;
        }
        .form-control {
            background: #2c3034;
            border: 1px solid #3a4148;
            color: #f8f9fa;
        }
        .form-control:focus {
            background: #2c3034;
            border-color: #86b7fe;
            color: #f8f9fa;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }
        .form-select {
            background: #2c3034;
            border: 1px solid #3a4148;
            color: #f8f9fa;
        }
        .form-label {
            color: #e9ecef;
        }
        .team-card {
            border-left: 4px solid #0d6efd;
            background: #262b30;
        }
        .pagination .page-link {
            background: #2c3034;
            border: 1px solid #3a4148;
            color: #f8f9fa;
        }
        .pagination .page-link:hover {
            background: #495057;
            color: #f8f9fa;
        }
        .pagination .active .page-link {
            background: #0d6efd;
            border-color: #0d6efd;
        }
        .pagination .disabled .page-link {
            background: #2c3034;
            color: #6c757d;
        }
        .login-card {
            border-left: 4px solid #fd7e14;
            margin-left: 20px;
            background: #2c3034;
        }
        .card-title {
            color: #e9ecef;
        }
        .card-subtitle {
            color: #adb5bd;
        }
        .card-text {
            color: #adb5bd;
        }
        .modal-content {
            background: #262b30;
            border: 1px solid #3a4148;
            color: #f8f9fa;
        }
        .modal-header {
            border-bottom: 1px solid #3a4148;
        }
        .modal-footer {
            border-top: 1px solid #3a4148;
        }
        .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }
        .text-muted {
            color: #adb5bd !important;
        }
        .btn-primary {
            background: #0d6efd;
            border: none;
        }
        .btn-primary:hover {
            background: #0b5ed7;
        }
        .btn-outline-primary {
            border-color: #0d6efd;
            color: #0d6efd;
        }
        .btn-outline-primary:hover {
            background: #0d6efd;
            color: #ffffff;
        }
        .btn-outline-light {
            border-color: #f8f9fa;
            color: #f8f9fa;
        }
        .btn-outline-light:hover {
            background: #f8f9fa;
            color: #1a1d21;
        }
        .bg-primary {
            background: #0d6efd !important;
        }
        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
        }
        .stat-value-teams {
            color: #0d6efd;
        }
        .stat-value-users {
            color: #fd9c47;
        }
        .stat-card-teams {
            border-top: 3px solid #0d6efd;
        }
        .stat-card-users {
            border-top: 3px solid #fd7e14;
        }
        .table {
            color: #f8f9fa;
            margin-bottom: 0;
        }
        .table thead th {
            color: #fd9c47;
            border-bottom: 2px solid #fd7e14;
            background: #2c3338;
        }
        .table td {
            border-color: #3a4148;
            vertical-align: middle;
        }
        .table tbody tr.text-success td {
            color: #2dd470;
            background: #1f2329;
        }
        .table tbody tr.text-success:hover td {
            background: #262b30;
        }
        .table tbody tr:hover {
            background: #2f363b;
        }
        .logins-table-card {
            background: #262b30;
            border: 1px solid #3a4148;
            border-left: 4px solid #fd7e14;
        }
        .badge-admin {
            background: #fd7e14;
            color: #fff;
        }
        .badge-user {
            background: #0d6efd;
            color: #fff;
        }
        h2 {
            color: #f8f9fa;
        }
        .card-header.bg-primary {
            background: #0d6efd !important;
        }
        /* Team card field labels and values in green */
        .team-field-label {
            color: #2dd470;
            font-weight: 600;
        }
        .team-field-value {
            color: #2dd470;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <%- include('../common/navbar', { activePage: 'sql-management', navbarFixed: false }) %>

    <div class="container mt-4">
        <div class="row mb-4">
            <div class="col-12">
                <h2>Teams & Logins Management (SQL)</h2>
                <p class="text-muted">Manage teams and their associated logins in SQLite database</p>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card stat-card-teams">
                    <div class="card-body">
                        <h5 class="card-title">Total Teams</h5>
                        <div class="stat-value stat-value-teams" id="statTotalTeams">-</div>
                        <p class="text-muted">Registered teams</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card stat-card-users">
                    <div class="card-body">
                        <h5 class="card-title">Total Users</h5>
                        <div class="stat-value stat-value-users" id="statTotalLogins">-</div>
                        <p class="text-muted">Registered logins</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Create Team Form -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Create New Team</h5>
                    </div>
                    <div class="card-body">
                        <form id="createTeamForm">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label for="teamName" class="form-label">Team Name</label>
                                        <input type="text" class="form-control" id="teamName" required>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label for="teamEmail" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="teamEmail" required>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="mb-3">
                                        <label for="instanceLimit" class="form-label">Instance Limit</label>
                                        <input type="number" class="form-control" id="instanceLimit" value="999" required>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="mb-3">
                                        <label for="teamEnabled" class="form-label">Enabled</label>
                                        <select class="form-select" id="teamEnabled">
                                            <option value="1">Yes</option>
                                            <option value="0">No</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">Create Team</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Teams List -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Teams <span class="badge bg-secondary" id="teamsTotalBadge"></span></h5>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" class="form-control form-control-sm" id="teamSearch" placeholder="Search by TeamID, name, email..." style="width: 220px;">
                            <select class="form-select form-select-sm" id="sortBySelect" style="width: auto;" onchange="loadTeams()">
                                <option value="TeamID">Sort: TeamID</option>
                                <option value="TeamName">Sort: Name</option>
                                <option value="Email">Sort: Email</option>
                                <option value="CreatedAt">Sort: Date</option>
                                <option value="InstanceLimit">Sort: Limit</option>
                                <option value="Enabled">Sort: Enabled</option>
                            </select>
                            <select class="form-select form-select-sm" id="sortDirSelect" style="width: auto;" onchange="loadTeams()">
                                <option value="asc">ASC</option>
                                <option value="desc">DESC</option>
                            </select>
                            <button class="btn btn-sm btn-outline-primary" onclick="loadTeams()">Refresh</button>
                        </div>
                    </div>
                    <div class="card-body" id="teamsContainer">
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer" id="teamsPagination" style="display:none;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <select class="form-select form-select-sm d-inline-block" id="pageSizeSelect" style="width: auto;" onchange="changePageSize()">
                                    <option value="10">10 / page</option>
                                    <option value="20" selected>20 / page</option>
                                    <option value="50">50 / page</option>
                                    <option value="100">100 / page</option>
                                </select>
                            </div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0" id="paginationNav"></ul>
                            </nav>
                            <div class="text-muted" id="pageInfo"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Login Modal -->
    <div class="modal fade" id="createLoginModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="createLoginForm">
                        <input type="hidden" id="loginTeamId">
                        <div class="mb-3">
                            <label for="loginName" class="form-label">Login ID</label>
                            <input type="email" class="form-control" id="loginName" required>
                        </div>
                        <div class="mb-3">
                            <label for="accessCode" class="form-label">Access Code (optional - auto-generated if empty)</label>
                            <input type="text" class="form-control" id="accessCode" placeholder="Leave empty to auto-generate">
                        </div>
                        <div class="mb-3">
                            <label for="permissions" class="form-label">Permissions (Hex)</label>
                            <input type="text" class="form-control" id="permissions" value="0xffffffff" required>
                            <small class="text-muted">e.g., 0xffffffff for full permissions</small>
                        </div>
                        <div class="mb-3">
                            <label for="isAdmin" class="form-label">Is Admin</label>
                            <select class="form-select" id="isAdmin">
                                <option value="0">No</option>
                                <option value="1">Yes</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="submitCreateLogin()">Create Login</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/public/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        let teamsData = [];
        let currentPage = 1;
        let totalPages = 1;
        let totalTeams = 0;
        let pageLimit = 20;
        let searchTimer = null;
        let currentSortBy = 'TeamID';
        let currentSortDir = 'asc';

        function loadStats() {
            fetch('/admin/api/sql/stats')
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        document.getElementById('statTotalTeams').textContent = 'N/A';
                        document.getElementById('statTotalLogins').textContent = 'N/A';
                        return;
                    }
                    document.getElementById('statTotalTeams').textContent = data.totalTeams || 0;
                    document.getElementById('statTotalLogins').textContent = data.totalLogins || 0;
                })
                .catch(error => {
                    console.error('Error loading stats:', error);
                    document.getElementById('statTotalTeams').textContent = 'N/A';
                    document.getElementById('statTotalLogins').textContent = 'N/A';
                });
        }

        function loadTeams(page) {
            if (page) currentPage = page;
            const search = document.getElementById('teamSearch').value.trim();
            currentSortBy = document.getElementById('sortBySelect').value;
            currentSortDir = document.getElementById('sortDirSelect').value;

            document.getElementById('teamsContainer').innerHTML = `
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `;

            let url = `/admin/api/sql/teams?page=${currentPage}&limit=${pageLimit}&sortBy=${currentSortBy}&sortDir=${currentSortDir}`;
            if (search) url += `&search=${encodeURIComponent(search)}`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        document.getElementById('teamsContainer').innerHTML = `
                            <div class="alert alert-danger">${data.errorMessage || 'Error loading teams'}</div>
                        `;
                        return;
                    }
                    teamsData = data.teams || [];
                    totalPages = data.totalPages || 1;
                    totalTeams = data.total || 0;
                    renderTeams();
                    renderPagination();
                })
                .catch(error => {
                    console.error('Error loading teams:', error);
                    document.getElementById('teamsContainer').innerHTML = `
                        <div class="alert alert-danger">
                            Error loading teams: ${error.message}
                        </div>
                    `;
                });
        }

        function renderTeams() {
            document.getElementById('teamsTotalBadge').textContent = totalTeams;

            if (teamsData.length === 0) {
                document.getElementById('teamsContainer').innerHTML = `
                    <div class="alert alert-info">
                        No teams found.
                    </div>
                `;
                return;
            }

            let html = '';
            teamsData.forEach(team => {
                html += `
                    <div class="card team-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="card-title">${team.TeamName}</h6>
                                    <p class="card-text mb-1">
                                        <small><span class="team-field-label">Team ID:</span> <span class="team-field-value">${team.TeamID}</span></small><br>
                                        <small><span class="team-field-label">Email:</span> <span class="team-field-value">${team.Email || 'N/A'}</span></small><br>
                                        <small><span class="team-field-label">Instance Limit:</span> <span class="team-field-value">${team.InstanceLimit}</span></small><br>
                                        <small><span class="team-field-label">Enabled:</span> <span class="team-field-value">${team.Enabled ? 'Yes' : 'No'}</span></small><br>
                                        <small><span class="team-field-label">Created:</span> <span class="team-field-value">${team.CreatedAt || 'N/A'}</span></small>
                                    </p>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-primary me-2" onclick="openCreateLoginModal(${team.TeamID}, '${team.TeamName}')">
                                        + Add Login
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteTeam(${team.TeamID})">
                                        Delete
                                    </button>
                                </div>
                            </div>
                            <div class="mt-3">
                                <h6 class="card-subtitle mb-2 text-muted">Logins (${team.logins ? team.logins.length : 0})</h6>
                                ${renderLogins(team.logins || [], team.TeamID)}
                            </div>
                        </div>
                    </div>
                `;
            });

            document.getElementById('teamsContainer').innerHTML = html;
        }

        function renderLogins(logins, teamId) {
            if (!logins || logins.length === 0) {
                return '<p class="text-muted mb-0">No logins for this team</p>';
            }

            let html = `
                <div class="table-responsive logins-table-card">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Login ID</th>
                                <th>Access Code</th>
                                <th>Permissions</th>
                                <th>Role</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            logins.forEach(login => {
                html += `
                    <tr class="text-success">
                        <td><strong>${login.LoginName}</strong></td>
                        <td>${login.AccessCode}</td>
                        <td>${login.Permissions}</td>
                        <td>${login.IsAdmin ? '<span class="badge badge-admin">Admin</span>' : '<span class="badge badge-user">User</span>'}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteLogin(${login.LoginID}, ${teamId})">
                                Delete
                            </button>
                        </td>
                    </tr>
                `;
            });
            html += `
                        </tbody>
                    </table>
                </div>
            `;
            return html;
        }

        function renderPagination() {
            const paginationEl = document.getElementById('teamsPagination');
            const navEl = document.getElementById('paginationNav');
            const pageInfoEl = document.getElementById('pageInfo');

            if (totalPages <= 1) {
                paginationEl.style.display = totalTeams === 0 ? 'none' : '';
                navEl.innerHTML = '';
            } else {
                paginationEl.style.display = '';

                let pagesHtml = '';
                const maxVisible = 7;
                let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                let endPage = Math.min(totalPages, startPage + maxVisible - 1);
                if (endPage - startPage < maxVisible - 1) {
                    startPage = Math.max(1, endPage - maxVisible + 1);
                }

                // Prev button
                pagesHtml += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="loadTeams(${currentPage - 1}); return false;">&laquo;</a>
                </li>`;

                // First page + ellipsis
                if (startPage > 1) {
                    pagesHtml += `<li class="page-item"><a class="page-link" href="#" onclick="loadTeams(1); return false;">1</a></li>`;
                    if (startPage > 2) pagesHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }

                // Page numbers
                for (let i = startPage; i <= endPage; i++) {
                    pagesHtml += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="loadTeams(${i}); return false;">${i}</a>
                    </li>`;
                }

                // Last page + ellipsis
                if (endPage < totalPages) {
                    if (endPage < totalPages - 1) pagesHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                    pagesHtml += `<li class="page-item"><a class="page-link" href="#" onclick="loadTeams(${totalPages}); return false;">${totalPages}</a></li>`;
                }

                // Next button
                pagesHtml += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="loadTeams(${currentPage + 1}); return false;">&raquo;</a>
                </li>`;

                navEl.innerHTML = pagesHtml;
            }

            const offsetStart = totalTeams === 0 ? 0 : (currentPage - 1) * pageLimit + 1;
            const offsetEnd = Math.min(currentPage * pageLimit, totalTeams);
            pageInfoEl.textContent = `${offsetStart}-${offsetEnd} of ${totalTeams}`;
        }

        function changePageSize() {
            pageLimit = parseInt(document.getElementById('pageSizeSelect').value);
            currentPage = 1;
            loadTeams();
        }

        document.getElementById('teamSearch').addEventListener('input', function() {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                currentPage = 1;
                loadTeams();
            }, 400);
        });

        function openCreateLoginModal(teamId, teamName) {
            document.getElementById('loginTeamId').value = teamId;
            document.getElementById('loginName').value = teamName;
            document.getElementById('accessCode').value = '';
            document.getElementById('permissions').value = '0xffffffff';
            document.getElementById('isAdmin').value = '0';

            const modal = new bootstrap.Modal(document.getElementById('createLoginModal'));
            modal.show();
        }

        function submitCreateLogin() {
            const teamId = document.getElementById('loginTeamId').value;
            const loginName = document.getElementById('loginName').value;
            const accessCode = document.getElementById('accessCode').value.trim();
            const permissions = document.getElementById('permissions').value;
            const isAdmin = document.getElementById('isAdmin').value;

            fetch('/admin/api/sql/logins', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    teamId: teamId,
                    loginName: loginName,
                    accessCode: accessCode || null, // Send null if empty to trigger auto-generation
                    permissions: permissions,
                    isAdmin: isAdmin
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error creating login: ' + data.error);
                } else {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('createLoginModal'));
                    modal.hide();
                    loadStats();
                    loadTeams();
                }
            })
            .catch(error => {
                console.error('Error creating login:', error);
                alert('Error creating login: ' + error.message);
            });
        }

        function deleteTeam(teamId) {
            if (!confirm('Are you sure you want to delete this team and all its logins?')) {
                return;
            }

            fetch(`/admin/api/sql/teams/${teamId}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error deleting team: ' + data.error);
                } else {
                    loadStats();
                    loadTeams();
                }
            })
            .catch(error => {
                console.error('Error deleting team:', error);
                alert('Error deleting team: ' + error.message);
            });
        }

        function deleteLogin(loginId, teamId) {
            if (!confirm('Are you sure you want to delete this login?')) {
                return;
            }

            fetch(`/admin/api/sql/logins/${loginId}`, {
                method: 'DELETE'
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error deleting login: ' + data.error);
                } else {
                    loadStats();
                    loadTeams();
                }
            })
            .catch(error => {
                console.error('Error deleting login:', error);
                alert('Error deleting login: ' + error.message);
            });
        }

        document.getElementById('createTeamForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const teamName = document.getElementById('teamName').value;
            const teamEmail = document.getElementById('teamEmail').value;
            const instanceLimit = document.getElementById('instanceLimit').value;
            const enabled = document.getElementById('teamEnabled').value;

            fetch('/admin/api/sql/teams', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    teamName: teamName,
                    email: teamEmail,
                    instanceLimit: instanceLimit,
                    enabled: enabled
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error creating team: ' + data.error);
                } else {
                    document.getElementById('createTeamForm').reset();
                    document.getElementById('instanceLimit').value = '999';
                    document.getElementById('teamEnabled').value = '1';
                    loadStats();
                    loadTeams();
                }
            })
            .catch(error => {
                console.error('Error creating team:', error);
                alert('Error creating team: ' + error.message);
            });
        });

        // Load teams on page load
        loadStats();
        loadTeams();
        setInterval(loadStats, 30000);
    </script>
</body>
</html>
