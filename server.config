{
    "server_id"                 : "AndruavAuth", // server id
    "server_ip"                 : "0.0.0.0",
    "server_port"               : 19408,
    
    "health_utl"                : "/h",    // SHOULD BE HARDCODED IN WEBCLIENT
    
    "account_storage_type"   : "single",  //[single,file,db]
    "single_account_user_name"  : "single@airgap.droneengage.com",
    "single_account_access_code": "test",
    //JSON User database file.
    "file_db"                    :"./file_db.json",
    

    // use fields below if account_storage_type is db (SQLite)
    "dbdatabase"                : "database/andruav.db",
    

    // logging
    "enableLog"                 : false,
    "log_directory"             : "./logs/",
    "log_timeZone"              : "GMT",
    "log_detailed"              : true,

    // dont send email with access code
    "ignoreEmail"               : true,


    "s2s_ws_listening_ip"       : "127.0.0.1", 
    "s2s_ws_listening_port"     : "19001", 

    // Server-to-Server (S2S) authentication. Auth only ACCEPTS comm servers, so it
    // needs the Ed25519 PUBLIC keys for each comm server (mapped by server_id).
    "s2s_auth_enabled"          : false,
    "s2s_trusted_server_keys"   : {
        "DE_CommSrv": "./ssl_local/DE_ServerComm_public.pem"
    },
    
    "enable_SSL"                : true,
    "ssl_key_file"              : "./ssl_local/ssl_airgap/domain.key",
    "ssl_cert_file"             : "./ssl_local/ssl_airgap/domain.crt",

    // Admin web interface
    "webadmin_enable"           : true,
    "admin_username"            : "admin",
    "admin_password"            : "$$HASH$$('admin123')",
    "session_secret"            : "change-this-secret-in-production",
    "webadmin_port"             : 8089,
    "webadmin_listening_ip"     : "0.0.0.0",

    // When set, the ENTIRE admin web interface is hidden — all /admin/*
    // routes return 404.  Access is only via /admin/<guid>/* (e.g.
    // /admin/sss/login) which is a secret URL to the login page.
    // Users must still authenticate with username/password.
    // Leave empty/null to keep the default behaviour (admin-auth at /admin/login).
    "servers_admin_url_guid"       : "",


    // Web Terminal — allows executing shell commands from the admin panel.
    // Runs with the server process privileges (root if server runs as root).
    // Disable in production if you do not need remote shell access.
    "webadmin_terminal_enabled" : true,

    "skip_hardware_validation"  : true, 

    "andruavSecurityEx"         : "Andruav Web Panel, Andruav Geo Fence Manager,  DRONE ENGAGE Web Client, Andruav Mobile, uavos"
 }
